# NVSentinel scale-test harness — central configuration.
#
# Every Phase 0 script sources this file. Override any value by exporting it in
# your shell before invoking a script, or by editing here. Keep it secret-free:
# pass credentials via your kubeconfig, not here.
#
# Set your kubectl context yourself before running (the harness uses the current
# one). Fixed cluster constants (the nvsentinel/monitoring/cert-manager/kwok
# namespaces) live in lib/common.sh, not here. This file holds only what the
# install scripts require plus the handful of knobs you actually change per run;
# every other tunable (node shape, ceiling ramp, guardrails, event counts,
# connector-pool sizing, mongo db/collection, metric labels…) has an identical
# default baked into harnessctl — see `harnessctl/config.go` (loadConfig).

# ---------------------------------------------------------------------------
# Component versions (pin these; bump deliberately per release)
# ---------------------------------------------------------------------------
export NVS_CHART="${NVS_CHART:-oci://ghcr.io/nvidia/nvsentinel}"
# Pin the chart tag. OCI registries have no "latest" index, so this must be an
# explicit published tag (see: helm show chart ${NVS_CHART} --version <tag>).
export NVS_CHART_VERSION="${NVS_CHART_VERSION:-v1.16.0}"
export KWOK_VERSION="${KWOK_VERSION:-v0.6.1}"
export CERT_MANAGER_VERSION="${CERT_MANAGER_VERSION:-v1.16.2}"
export KPS_CHART_VERSION="${KPS_CHART_VERSION:-65.5.0}"

# ---------------------------------------------------------------------------
# Commonly edited per run
# ---------------------------------------------------------------------------
# NOTE: the KWOK node count is NOT set here — pass it per run on the CLI:
#   harnessctl scale-nodes -count 10000
#   harnessctl connector-pool -emulated-nodes 10000
# (KWOK_NODE_COUNT still works as an optional shell override if you prefer.)

# Synthetic providerID scheme stamped on each fake node (e.g. kwok://kwok-gpu-42).
# REQUIRED on managed clusters (AKS/EKS/GKE): a provider-less Node is deleted by
# the cloud node-lifecycle controller, so without this KWOK nodes are silently
# reaped and the target count is never reached. Empty = don't set one (only safe
# on non-cloud clusters like Kind).
export KWOK_PROVIDER_ID_SCHEME="${KWOK_PROVIDER_ID_SCHEME:-kwok}"

# NOTE: the P0.3 reconciler needs no MongoDB URI here — it runs in-cluster and
# derives the (mTLS) connection from the NVSentinel datastore secret. Set
# HARNESS_MONGO_URI in your shell only for the rare out-of-cluster CLI reconcile.

# ---------------------------------------------------------------------------
# Output
# ---------------------------------------------------------------------------
# Where scripts and tools write their JSON/markdown artifacts.
export HARNESS_RESULTS_DIR="${HARNESS_RESULTS_DIR:-$(cd "$(dirname "${BASH_SOURCE[0]:-.}")/.." 2>/dev/null && pwd)/results}"
