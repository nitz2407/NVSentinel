# NVSentinel scale-test harness — central configuration.
#
# Every Phase 0 script sources this file. Override any value by exporting it in
# your shell before invoking a script, or by editing this file. Keep it free of
# secrets: pass credentials via your kubeconfig / sealed secrets, not here.

# ---------------------------------------------------------------------------
# Cluster / namespaces
# ---------------------------------------------------------------------------
# The kubeconfig context the harness operates against. Empty = current context.
export HARNESS_KUBE_CONTEXT="${HARNESS_KUBE_CONTEXT:-}"

# Namespace NVSentinel is installed into.
export NVS_NAMESPACE="${NVS_NAMESPACE:-nvsentinel}"

# Namespace for kube-prometheus-stack.
export MONITORING_NAMESPACE="${MONITORING_NAMESPACE:-monitoring}"

# Namespace the KWOK controller runs in.
export KWOK_NAMESPACE="${KWOK_NAMESPACE:-kube-system}"

# ---------------------------------------------------------------------------
# Component versions (pin these; bump deliberately per release)
# ---------------------------------------------------------------------------
# NVSentinel Helm chart. Phase 0 installs from the public OCI chart.
export NVS_CHART="${NVS_CHART:-oci://ghcr.io/nvidia/nvsentinel}"
export NVS_CHART_VERSION="${NVS_CHART_VERSION:-}"   # empty = latest published

# KWOK release (https://github.com/kubernetes-sigs/kwok/releases).
export KWOK_VERSION="${KWOK_VERSION:-v0.6.1}"

# kube-prometheus-stack chart version.
export KPS_CHART_VERSION="${KPS_CHART_VERSION:-65.5.0}"

# ---------------------------------------------------------------------------
# Simulated-node scale (P0.2)
# ---------------------------------------------------------------------------
# Target number of simulated KWOK nodes for the Phase 0 demonstration.
export KWOK_NODE_COUNT="${KWOK_NODE_COUNT:-50000}"

# Node name prefix. Simulated nodes are named ${KWOK_NODE_PREFIX}-<index>.
export KWOK_NODE_PREFIX="${KWOK_NODE_PREFIX:-kwok-gpu}"

# Batch size when creating nodes (server-side apply in chunks to avoid
# overwhelming the API server / local apply process).
export KWOK_NODE_BATCH="${KWOK_NODE_BATCH:-500}"

# GPU shape advertised on each simulated node.
export KWOK_GPU_COUNT="${KWOK_GPU_COUNT:-8}"
export KWOK_NODE_CPU="${KWOK_NODE_CPU:-192}"
export KWOK_NODE_MEMORY="${KWOK_NODE_MEMORY:-2048Gi}"
export KWOK_NODE_PODS="${KWOK_NODE_PODS:-110}"

# ---------------------------------------------------------------------------
# P0.2 ceiling guardrails — a run is "healthy" only while these hold.
# ---------------------------------------------------------------------------
# Max acceptable API server p99 request latency (seconds) during node ramp.
export MAX_APISERVER_P99_SECONDS="${MAX_APISERVER_P99_SECONDS:-1.0}"
# How long (seconds) to wait for the full node count to become Ready.
export NODE_READY_TIMEOUT="${NODE_READY_TIMEOUT:-1800}"

# ---------------------------------------------------------------------------
# Event injection / reconciliation (P0.3)
# ---------------------------------------------------------------------------
# Bounded batch of events for the Phase 0 injection demonstration.
export P03_EVENT_COUNT="${P03_EVENT_COUNT:-10000}"
export P03_EVENT_RATE="${P03_EVENT_RATE:-500}"   # events/sec
# Single harnessctl image, used both as the operator CLI and the in-cluster Job
# image (harnessctl inject / harnessctl reconcile). Must be reachable by the cluster.
export HARNESS_IMAGE_REGISTRY="${HARNESS_IMAGE_REGISTRY:-CHANGE_ME.example.com/nvsentinel-harness}"
export HARNESS_IMAGE="${HARNESS_IMAGE:-${HARNESS_IMAGE_REGISTRY}/harnessctl:v1}"

# MongoDB access for the reconciler. The reconciler connects from inside the
# cluster (it runs as a Job). Provide a full connection URI reachable from the
# NVSentinel namespace, e.g.:
#   mongodb://root:PASSWORD@mongodb-store-headless.nvsentinel.svc:27017/?replicaSet=rs0&authSource=admin
# Leave empty to have the P0.3 check attempt to derive it from the datastore secret.
export HARNESS_MONGO_URI="${HARNESS_MONGO_URI:-}"
export MONGO_DATABASE="${MONGO_DATABASE:-HealthEventsDatabase}"
export MONGO_COLLECTION="${MONGO_COLLECTION:-HealthEvents}"
# Metadata key the injector stamps on every event and the reconciler matches on.
export HARNESS_RUN_LABEL="${HARNESS_RUN_LABEL:-nvs_harness_run}"
export HARNESS_ID_LABEL="${HARNESS_ID_LABEL:-nvs_harness_id}"

# Acceptable event-loss threshold for a PASS (fraction). Phase 0 demands zero.
export P03_MAX_LOSS_FRACTION="${P03_MAX_LOSS_FRACTION:-0.0}"

# ---------------------------------------------------------------------------
# Janitor action path (P0.4)
# ---------------------------------------------------------------------------
# Delay (seconds) the KWOK Job-completion stage waits before completing a
# reboot / GPU-reset Job, so MTTR measurements are non-trivial.
export KWOK_JOB_COMPLETE_DELAY="${KWOK_JOB_COMPLETE_DELAY:-30}"
export P04_ACTION_TIMEOUT="${P04_ACTION_TIMEOUT:-300}"

# ---------------------------------------------------------------------------
# Output
# ---------------------------------------------------------------------------
# Where check scripts and tools write their JSON/markdown artifacts.
export HARNESS_RESULTS_DIR="${HARNESS_RESULTS_DIR:-$(cd "$(dirname "${BASH_SOURCE[0]:-.}")/.." 2>/dev/null && pwd)/results}"
